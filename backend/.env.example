# Copy this file to ".env" and fill in your token.
#   cp .env.example .env

# Your GitHub Personal Access Token (create at https://github.com/settings/tokens).
# A classic token with "read:user" + "repo" scopes works well.
GITHUB_PAT=your_github_personal_access_token_here

# Port the API runs on.
PORT=8000

# Set to false in production.
FLASK_DEBUG=true

# Which frontend origins may call this API (comma-separated).
# Vite's dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173

# How long (seconds) to cache each user's data.
CACHE_TTL=120
